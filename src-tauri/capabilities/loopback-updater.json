{
  "$schema": "../gen/schemas/remote-schema.json",
  "identifier": "loopback-updater",
  "description": "Permessi updater concessi esclusivamente al frontend locale incorporato",
  "local": false,
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "allow-minimize-main-window",
    "allow-load-course-progress",
    "allow-save-course-progress",
    "core:window:allow-minimize",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/Federpelli/JAVA_LINGUO/releases/latest"
        }
      ]
    }
  ]
}
