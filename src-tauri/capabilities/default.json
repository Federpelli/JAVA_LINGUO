{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permessi minimi della finestra principale di JAVA_linguo",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/Federpelli25/JAVA_linguo/releases/latest"
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "java-linguo-backend",
          "sidecar": true,
          "args": ["--desktop", "--port", { "validator": "^[0-9]{1,5}$" }]
        }
      ]
    }
  ]
}
